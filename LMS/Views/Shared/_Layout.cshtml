<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/" href="~/images/EdoNova.logotitle.png" />
    <title>@ViewData["Title"] - EduNova</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body class="dashboard-body">

    <div class="dashboard-wrapper">

        <header>
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container">

                    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                        EduNova
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarNav">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <div class="collapse navbar-collapse" id="navbarNav">

                        <ul class="navbar-nav ms-auto">

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    خانه
                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                    درباره
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>
            </nav>
        </header>



        <main role="main" class="dashboard-container">
            <div class="dashboard-content">
                @RenderBody()
            </div>
        </main>



        <footer class="footer text-center">

            <div class="container">

                © 1405 - EduNova

            </div>

        </footer>


    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>