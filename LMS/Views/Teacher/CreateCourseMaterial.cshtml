@{
    ViewData["Title"] = "افزودن محتوای آموزشی";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";

    var course = ViewBag.Course as LMS.Models.Course;
}

<div class="dashboard-header">

    <h2>➕ افزودن محتوای آموزشی</h2>

    <p>
        افزودن محتوای جدید به دوره
        <strong>@course?.Title</strong>
    </p>

</div>

<div class="dashboard-section">

    <form asp-controller="Teacher"
          asp-action="CreateCourseMaterial"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="courseId"
               value="@course?.CourseID" />


        <div class="form-group mb-3">

            <label class="form-label">
                عنوان محتوا
            </label>

            <input type="text"
                   name="title"
                   class="form-control"
                   placeholder="مثلاً جزوه جلسه اول"
                   required />

        </div>


        <div class="form-group mb-3">

            <label class="form-label">
                توضیحات
            </label>

            <textarea name="description"
                      class="form-control"
                      rows="4"
                      placeholder="توضیحات مربوط به این محتوا"></textarea>

        </div>


        <div class="form-group mb-3">

            <label class="form-label">
                نوع محتوا
            </label>

            <select name="materialType"
                    class="form-select"
                    required>

                <option value="">انتخاب نوع محتوا</option>

                <option value="PDF">📄 فایل PDF</option>

                <option value="Word">📝 فایل Word</option>

                <option value="PowerPoint">📊 فایل PowerPoint</option>

                <option value="ZIP">📦 فایل ZIP</option>

                <option value="Text">📃 متن آموزشی</option>

                <option value="Other">📁 سایر</option>

            </select>

        </div>


        <div class="form-group mb-3">

            <label class="form-label">
                انتخاب فایل
            </label>

            <input type="file"
                   name="file"
                   class="form-control" />

            <small class="text-muted">
                فایل موردنظر را از کامپیوتر خود انتخاب کنید.
            </small>

        </div>


        <div class="d-flex gap-2">

            <button type="submit"
                    class="teacher-action">

                💾 ثبت محتوا

            </button>


            <a asp-controller="Teacher"
               asp-action="CourseMaterials"
               asp-route-id="@course?.CourseID"
               class="teacher-action manage-link">

                ↩️ بازگشت

            </a>

        </div>

    </form>

</div>